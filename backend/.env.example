APP_NAME=
NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://127.0.0.1:27017/reelease
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=

# Installer gate. SERVER_ADDR = this machine's IP (127.0.0.1 locally, public IP on a server).
APP_ID=MkNTUlBDS0NOSg==
SERVER_ADDR=127.0.0.1

# true = public read-only demo: every POST/PUT/DELETE is rejected (settings, posts, AI generation), OTP fixed to 123456.
APP_DEMO_MODE=false

# Admin Credentials
ADMIN_EMAIL=admin@reeleaseai.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Reelease Admin

DEFAULT_USER_EMAIL=john@reeleaseai.com
DEFAULT_USER_PASSWORD=123456789
DEFAULT_USER_NAME=John Doe

# APP_URL = public URL of THIS API (used to build /uploads links sent to AI providers + cron calls).
# FRONTEND_URL = public URL of the Next.js app (email links, payment redirects).
# AI providers (Kie.ai, OpenAI) must be able to reach APP_URL, so localhost only works for text-only features.
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5176
ALLOWED_ORIGINS=http://localhost:5176

# AI keys — read by `npm run seed`. Keys saved later in Admin → AI Models are kept on re-seed.
KIE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=
MAIL_ENCRYPTION=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_SECRET=
RAZORPAY_KEY_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=
